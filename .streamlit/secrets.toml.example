# Copy to `.streamlit/secrets.toml` for Streamlit Cloud deployments.
# Streamlit exposes these to the app as environment variables via st.secrets;
# this project reads them through the same IPL_* names as .env.
#
# NEVER commit the real secrets.toml - it is git-ignored.

IPL_DATABASE_URL = "sqlite:///data/ipl.db"
IPL_ADMIN_PASSWORD = "set-a-strong-password-here"
IPL_LOG_LEVEL = "INFO"

# For a hosted Postgres (e.g. Supabase, Neon, Railway):
# IPL_DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/ipl"
