# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. Every value below has a sane default,
# so an empty `.env` still produces a working local SQLite-backed setup.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Any SQLAlchemy URL. Pick ONE of the following styles:
#
#   SQLite (default, zero-config, used by Streamlit Cloud demos)
#     sqlite:///data/ipl.db
#   PostgreSQL
#     postgresql+psycopg2://ipl_user:ipl_pass@localhost:5432/ipl
#   MySQL / MariaDB
#     mysql+pymysql://ipl_user:ipl_pass@localhost:3306/ipl
IPL_DATABASE_URL=sqlite:///data/ipl.db

# Echo every SQL statement to the log (very noisy - debugging only).
IPL_DB_ECHO=false

# --- Data collection --------------------------------------------------------
# Seconds to wait between consecutive requests to the IPL feed host.
# Keep this >= 0.5 to stay a polite consumer of a public endpoint.
IPL_REQUEST_DELAY=0.6

# Per-request timeout (seconds) and retry budget.
IPL_REQUEST_TIMEOUT=45
IPL_MAX_RETRIES=4

# Cache raw feed payloads on disk so re-runs do not re-download anything.
IPL_USE_HTTP_CACHE=true
IPL_HTTP_CACHE_TTL_HOURS=12

# Pull IPL 2008-2018 (not published by the official feed) from Cricsheet.
IPL_ENABLE_CRICSHEET=true

# Ingest ball-by-ball deliveries. Adds ~250k rows; set false for a fast run.
IPL_INGEST_DELIVERIES=true

# --- Modelling --------------------------------------------------------------
# Seasons on/after this year are held out as the test set (time-based split).
# Three seasons gives ~215 test matches; fewer makes the metrics too noisy to
# tell the models apart.
IPL_TEST_SEASON_FROM=2024
IPL_RANDOM_STATE=42

# --- Dashboard / API --------------------------------------------------------
IPL_API_HOST=0.0.0.0
IPL_API_PORT=8000

# Password gating the dashboard's Admin page. CHANGE THIS before deploying.
IPL_ADMIN_PASSWORD=change-me

# --- Logging ----------------------------------------------------------------
IPL_LOG_LEVEL=INFO
