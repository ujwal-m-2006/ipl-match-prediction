# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Project data artefacts ---
# Raw feed payloads and the local SQLite DB are reproducible: never commit them.
data/raw/
data/interim/
data/external/
data/*.db
data/*.sqlite
data/*.sqlite3

# ...except the two databases that ship with the project, so a clone is
# immediately usable without a 20-minute ingest:
#   ipl.db        the full warehouse, including all 280k deliveries (~46 MB)
#   ipl_deploy.db a slim copy without deliveries, for memory-limited hosts
# Rebuild the slim one with `python scripts/build_deploy_db.py`.
!data/ipl.db
!data/ipl_deploy.db
*.db-journal

# SQLite sidecar files created by WAL mode.
*.db-journal
*.db-shm
*.db-wal

# Trained models are committed so a hosted deployment works without a training
# run (Streamlit Cloud has ~1 GB of RAM, too little to fit the chase model).
# Everything else under artifacts/ stays ignored.
models/artifacts/*
!models/artifacts/*.joblib
!models/artifacts/*_metrics.json
models/*.pkl

# Generated reports
reports/figures/
reports/*.html

# Runtime logs
logs/

# --- Tooling ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Transient logs from launcher testing
_*.log
